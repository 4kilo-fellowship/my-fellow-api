# 4 Kilo Fellowship Backend (my-fellow-api) Environment Configuration
# Copy this file to .env and configure all secrets for production

# Server Configuration
PORT=3000
NODE_ENV=production
API_URL=https://my-fellow-api.onrender.com

# Databases
# MongoDB Atlas (User Accounts, Fellowship Records, Better Auth sessions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fellowship?retryWrites=true&w=majority

# PostgreSQL / Supabase (Prisma 7: Social Graph, Content Items, Marketplace)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Better Auth Configuration
BETTER_AUTH_SECRET=replace_with_a_secure_random_string
BETTER_AUTH_URL=https://my-fellow-api.onrender.com

# SMS Gateway (GeezSMS) for Ethiopian Phone-Only OTP
GEEZ_API_KEY=your_geezsms_api_key_here
OTP_DEV_MODE=false
OTP_DEV_CODE=123456

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Generation Services (Optional / Feature-Flagged)
GEMINI_API_KEY=your_google_gemini_api_key
FAL_KEY=your_fal_ai_key

# Jami Payment Gateway (https://dev.jami.bio/)
# Supports Telebirr, CBE Birr, M-Pesa, and cards
JAMI_TOKEN=jamidev_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JAMI_WEBHOOK_SECRET=jamidev_whsec_xxxxxxxxxxxxxxxxxxxxxxxx
JAMI_RETURN_URL=https://my-fellow-api.onrender.com/api/payments/success?sessionId={CHECKOUT_ID}
